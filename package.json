{
  "name": "@devdonzo/warden",
  "version": "1.8.0",
  "description": "Autonomous SRE & Security Orchestration Agent - The Warden of your Codebase",
  "main": "dist/index.js",
  "bin": {
    "warden": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "schemas/",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md",
    "docs/EXAMPLE-CI.md",
    "docs/OPEN-SOURCE-MAINTENANCE.md",
    "docs/WARDEN-VS-CODEX.md",
    "docs/SPEC/"
  ],
  "scripts": {
    "test": "jest",
    "test:ci": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watchman": "ts-node src/agents/watchman/index.ts",
    "watchman:scan": "ts-node src/agents/watchman/index.ts",
    "cli": "ts-node src/cli.ts",
    "validate": "ts-node src/cli.ts validate",
    "setup": "ts-node src/cli.ts setup",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "clean": "rm -rf dist coverage logs scan-results .npm-cache *.log",
    "clean:video": "rm -rf video/out",
    "clean:all": "npm run clean && npm run clean:video",
    "smoke": "node scripts/smoke-test.js && node scripts/package-smoke-test.js",
    "release:check": "npm run clean:all && npm run build && npm test && npm run smoke && npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "security",
    "automation",
    "vulnerability",
    "vulnerability-scanner",
    "snyk",
    "sre",
    "devops",
    "github",
    "dependency-scanning",
    "security-automation",
    "automated-fixes",
    "pull-requests",
    "ci-cd",
    "security-tools",
    "agentic-ai",
    "github-actions"
  ],
  "author": {
    "name": "DevDonzo",
    "url": "https://github.com/DevDonzo"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevDonzo/warden.git"
  },
  "homepage": "https://warden.hamzaparacha.me",
  "bugs": {
    "url": "https://github.com/DevDonzo/warden/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ora": "^5.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.2.0",
    "prettier": "^3.8.3",
    "snyk": "^1.1302.0",
    "ts-jest": "^29.4.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
